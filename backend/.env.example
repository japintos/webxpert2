# Backend FastAPI — copiar a `backend/.env`
# Nunca commitear el archivo `.env` real.

ENVIRONMENT=development

# PostgreSQL local (docker compose up -d db)
# DATABASE_URL=postgresql+psycopg://webxpert:webxpert@localhost:5432/webxpert
# SQLite para localhost sin Docker:
DATABASE_URL=sqlite:///./webxpert.db

# Railway inyecta DATABASE_URL (postgres://...). El API lo convierte a postgresql+psycopg://
# No hace falta copiar la URL a mano si el plugin Postgres está ligado al servicio.

# JWT — en producción: mínimo 32 caracteres, nunca el valor de desarrollo
JWT_SECRET=dev-only-change-me-before-production
JWT_EXPIRE_MINUTES=720

# CORS (coma-separado). En Railway:
# CORS_ORIGINS=https://www.webxpert.com.ar,https://webxpert.com.ar
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin inicial (se crea en el seed)
ADMIN_EMAIL=admin@webxpert.com
ADMIN_PASSWORD=changeme

# OpenAI / Gemini — dejar vacío en local si todavía no hay clave; el bot usa FAQ/knowledge.
# El proveedor activo se elige en el panel Admin → Assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Logs: no registrar cuerpos de mensajes por defecto (privacidad)
LOG_LEVEL=INFO
LOG_MESSAGE_BODY=false
